rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'nitesh933438@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Public Academic Records: Read-only for portfolio visitors, writeable only by authenticated admin
    match /academic_records/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Marksheet Audit & Upload Trails: Private to authenticated admin only
    match /academic_audit/{auditId} {
      allow read, write: if isAdmin();
    }

    // Certifications: published records are readable publicly; all records and write operations restricted to admin
    match /certifications/{certificateId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Projects: published projects are readable publicly; write operations restricted to admin
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Contact Messages: Anyone can submit an inquiry; read, update (mark read), and delete restricted to admin
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 120 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() > 0 &&
                       request.resource.data.email.size() <= 150 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // Portfolio Metadata & Settings: Configuration readable publicly; modified only by admin
    match /site_metadata/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

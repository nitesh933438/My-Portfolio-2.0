GEMINI_API_KEY=
FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=sapient-spot-gfbwx

# Supabase Storage Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only secret. Never use a VITE_ prefix or expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-assets

# Optional: set this only when the frontend and Express API are hosted separately.
# Example: https://your-api-service.onrender.com
VITE_API_BASE_URL=
# Optional allowed frontend origins for a separately hosted API (comma-separated).
CORS_ORIGIN=
# Optional Gemini model override; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
